generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model MutationBatch {
  id          String          @id @default(uuid())
  projectId   String
  userId      String
  source      String
  operationId String?
  summary     String?         @db.Text
  status      String          @default("active") // active | reverted | failed
  revertError String?         @db.Text
  revertedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  entries     MutationEntry[]
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("mutation_batches")
}

model MutationEntry {
  id         String        @id @default(uuid())
  batchId    String
  kind       String
  targetType String
  targetId   String
  payload    Json?
  createdAt  DateTime      @default(now())
  batch      MutationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([targetType, targetId])
  @@map("mutation_entries")
}

model ProjectAssistantThread {
  id              String             @id @default(uuid())
  projectId       String
  userId          String
  assistantId     String
  runtimeThreadId String?            @unique @db.VarChar(191)
  clearRequestId  String?            @db.VarChar(128)
  messagesJson    Json
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns           ProjectAgentTurn[]

  @@unique([projectId, userId, assistantId])
  @@index([projectId, updatedAt])
  @@index([userId, updatedAt])
  @@map("project_assistant_threads")
}

model ProjectAgentTurn {
  id                 String                 @id @db.VarChar(191)
  threadId           String
  projectId          String
  userId             String
  sourceKind         String                 @db.VarChar(32)
  sourceId           String                 @db.VarChar(191)
  payloadHash        String                 @db.VarChar(64)
  requestId          String                 @db.VarChar(128)
  status             String                 @default("queued") @db.VarChar(32)
  attempt            Int                    @default(0)
  executionOwnerId   String?                @db.VarChar(191)
  userMessageJson    Json?
  contextJson        Json
  planJson           Json?
  runtimeTurnId      String?                @unique @db.VarChar(191)
  assistantMessageId String?                @db.VarChar(191)
  stopReason         String?                @db.VarChar(64)
  failure            Json?
  cancelRequestId    String?                @db.VarChar(128)
  cancelReason       String?                @db.Text
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  thread             ProjectAssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  toolEffects        AgentToolEffect[]
  interactions       AgentTurnInteraction[]
  providerAttempts   ProjectAgentProviderAttempt[]

  @@unique([threadId, sourceKind, sourceId])
  @@index([threadId, status, createdAt])
  @@index([projectId, userId, status, createdAt])
  @@map("project_agent_turns")
}

model ProjectAgentProviderAttempt {
  sequence             BigInt           @id @default(autoincrement())
  id                   String           @unique @db.VarChar(191)
  turnId               String
  runtimeAttempt       Int
  providerKey          String           @db.VarChar(64)
  modelKey             String           @db.VarChar(191)
  requestHash          String           @db.VarChar(64)
  status               String           @default("started") @db.VarChar(32)
  providerStatus       Int?
  providerRequestId    String?          @db.VarChar(256)
  providerGenerationId String?          @db.VarChar(256)
  failure              Json?
  startedAt            DateTime         @default(now())
  finishedAt           DateTime?
  turn                 ProjectAgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@index([turnId, runtimeAttempt, sequence])
  @@index([status, startedAt])
  @@map("project_agent_provider_attempts")
}

model AgentToolEffect {
  id               String           @id @db.VarChar(191)
  turnId           String
  callId           String           @db.VarChar(191)
  operationId      String           @db.VarChar(128)
  contractRevision String           @db.VarChar(128)
  inputHash        String           @db.VarChar(64)
  resultJson       Json
  completedAt      DateTime         @default(now())
  createdAt        DateTime         @default(now())
  turn             ProjectAgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, callId])
  @@index([operationId, completedAt])
  @@map("agent_tool_effects")
}

model AgentTurnInteraction {
  id               String           @id @db.VarChar(191)
  turnId           String
  kind             String           @db.VarChar(32)
  status           String           @default("pending") @db.VarChar(32)
  payloadJson      Json
  runtimeRequestId String?          @db.VarChar(191)
  responseJson     Json?
  version          Int              @default(0)
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  turn             ProjectAgentTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)

  @@unique([turnId, runtimeRequestId])
  @@index([turnId, status, createdAt])
  @@map("agent_turn_interactions")
}

/// 用户清空会话时的系统内归档：对用户不可见，仅供依权限的滥用调查/争议追溯。
/// 不挂 Project 外键——项目删除后归档仍需保留；挂 User 级联——账号注销时一并清除。
model ProjectAssistantThreadArchive {
  id               String   @id @default(uuid())
  threadId         String
  projectId        String
  userId           String
  assistantId      String
  runtimeThreadId  String?  @db.VarChar(191)
  messagesJson     Json
  clearRequestId   String?  @db.VarChar(128)
  cancelledTurnIds Json?
  threadCreatedAt  DateTime
  threadUpdatedAt  DateTime
  archivedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId])
  @@index([projectId, userId, archivedAt])
  @@index([userId, archivedAt])
  @@map("project_assistant_thread_archives")
}

/// 用户消息的唯一命令身份与 handoff tombstone。它不挂 Thread/Turn 外键，
/// 因为 clear 只能清除对话 View，不能清除延迟 HTTP retry 的去重事实。
model ProjectAssistantMessageCommand {
  id            String    @id @db.VarChar(191)
  projectId     String
  userId        String
  assistantId   String    @db.VarChar(64)
  sourceId      String    @db.VarChar(191)
  payloadHash   String    @db.VarChar(64)
  kind          String    @db.VarChar(32)
  status        String    @db.VarChar(32)
  threadId      String    @db.VarChar(191)
  turnId        String    @db.VarChar(191)
  runtimeTurnId String?   @db.VarChar(191)
  messageJson   Json
  acceptedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, assistantId, sourceId])
  @@index([threadId, createdAt])
  @@index([turnId, status, createdAt])
  @@map("project_assistant_message_commands")
}

model Project {
  id                        String                           @id @default(uuid())
  name                      String
  description               String?                          @db.Text
  userId                    String
  workspaceResourceRevision Int                              @default(0)
  videoRatio                String?
  videoResolution           String                           @default("720p")
  imageResolution           String                           @default("2K")
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @default(now()) @updatedAt
  lastAccessedAt            DateTime?
  user                      User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageCosts                UsageCost[]
  assistantThreads          ProjectAssistantThread[]
  assistantMessageCommands  ProjectAssistantMessageCommand[]
  mutationBatches           MutationBatch[]
  workspaceResources        WorkspaceResource[]
  canvasLayouts             ProjectCanvasLayout[]

  @@index([userId])
  @@map("projects")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique(map: "Session_sessionToken_key")
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model UsageCost {
  id             String   @id @default(uuid())
  projectId      String
  userId         String
  apiType        String
  model          String
  action         String
  quantity       Int
  unit           String
  /// Exact retail usage in credits. LLM rows keep six decimal places while
  /// the balance ledger remains integer-only.
  cost           Decimal  @db.Decimal(18, 6)
  /// Whole credits actually removed from the balance when this fact settled.
  chargedCredits Int      @default(0)
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([apiType])
  @@index([createdAt])
  @@index([projectId])
  @@index([userId])
  @@map("usage_costs")
}

model User {
  id                   String                @id @default(uuid())
  name                 String                @unique(map: "User_name_key")
  email                String?
  emailVerified        DateTime?
  image                String?
  password             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now()) @updatedAt
  accounts             Account[]
  projects             Project[]
  sessions             Session[]
  usageCosts           UsageCost[]
  llmBillingMeter      LlmBillingMeter?
  balance              UserBalance?
  subscription         Subscription?
  preferences          UserPreference?
  paidBetaSeats        PaidBetaSeat[]
  announcementReceipts AnnouncementReceipt[]

  // 资产中心
  globalAssetFolders              GlobalAssetFolder[]
  globalCharacters                GlobalCharacter[]
  globalLocations                 GlobalLocation[]
  tasks                           Task[]
  taskEvents                      TaskEvent[]
  projectAssistantThreads         ProjectAssistantThread[]
  projectAssistantThreadArchives  ProjectAssistantThreadArchive[]
  projectAssistantMessageCommands ProjectAssistantMessageCommand[]
  mutationBatches                 MutationBatch[]
  workspaceResources              WorkspaceResource[]

  @@map("user")
}

model UserPreference {
  id                                   String   @id @default(uuid())
  userId                               String   @unique
  assistantModel                       String? // The single fixed model slot; every other model is chosen by the Assistant from the enabled pool
  analysisConcurrency                  Int? // 分析流程并发上限
  imageConcurrency                     Int? // 图像流程并发上限
  videoConcurrency                     Int? // 视频流程并发上限
  videoRatio                           String   @default("9:16")
  videoResolution                      String   @default("720p")
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @default(now()) @updatedAt
  imageResolution                      String   @default("2K")
  /// Fixed per-model parameters. Null/missing fields are chosen by the Agent.
  capabilityDefaults                   String?  @db.Text
  assistantBillingConfirmationRequired Boolean  @default(true)

  // API Key 配置（极简版）
  llmBaseUrl  String? @default("https://openrouter.ai/api/v1")
  llmApiKey   String? @db.Text // 加密存储
  falApiKey   String? @db.Text // FAL（图片+视频）
  googleAiKey String? @db.Text // Google AI（Gemini 图片）
  arkApiKey   String? @db.Text // 火山引擎（Seedream+Seedance）

  // 自定义模型列表 + 价格（JSON）
  customModels String? @db.Text

  // 自定义 OpenAI 兼容提供商列表（JSON，包含加密的 API Key）
  customProviders String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model VerificationToken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_key")
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtoken")
}

model UserBalance {
  id                    String    @id @default(uuid())
  userId                String    @unique
  /// Permanent pool: top-ups and manual grants. Never expires.
  balance               Int       @default(0)
  /// Subscription pool: granted each period, expires at `subscriptionExpiresAt`
  /// and is always consumed before `balance` so it is not wasted.
  subscriptionCredits   Int       @default(0)
  subscriptionExpiresAt DateTime?
  frozenAmount          Int       @default(0)
  totalSpent            Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_balances")
}

/// Per-user rounding carry for realtime LLM settlement. Provider generations
/// settle one by one, but the integer credit ledger only moves when cumulative
/// exact retail usage crosses a whole-credit boundary.
model LlmBillingMeter {
  userId                     String   @id
  prepaidMicrocredits        BigInt   @default(0)
  totalRetailMicrocredits    BigInt   @default(0)
  totalChargedCredits        Int      @default(0)
  totalUncoveredMicrocredits BigInt   @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("llm_billing_meters")
}

/// One user's subscription. A user has at most one; changing plan updates this
/// row rather than creating a second one, so there is never a second opinion
/// about which plan is in force.
/// A paid plan term.
///
/// Plans are bought outright rather than subscribed to, because WeChat Pay —
/// the payment method most of these users have — cannot back an automatically
/// renewing charge on Stripe. Every later payment starts a new paid term and
/// updates this projection, so a user is on exactly one plan at a time and
/// there is never a second opinion about which.
model Subscription {
  id                 String              @id @default(uuid())
  userId             String              @unique
  planId             String              @db.VarChar(32)
  interval           String              @db.VarChar(8)
  /// Canonical identity of the paid term currently projected by this row.
  currentTermKey     String              @db.VarChar(128)
  /// `active` while the paid term covers today; `expired` once it does not.
  status             String              @db.VarChar(32)
  /// Start of the current paid term. Monthly grants are counted from here.
  currentPeriodStart DateTime
  /// End of what has been paid for. Grants stop at this boundary.
  currentPeriodEnd   DateTime
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  grants             SubscriptionGrant[]

  @@index([status])
  @@map("subscriptions")
}

/// One credit grant for one month of a subscription. `periodIndex` counts
/// months from the start of the paid term, so a yearly subscription grants
/// twelve times from a single payment. The unique key makes a replayed or
/// retried grant a no-op instead of free credits.
model SubscriptionGrant {
  id             String       @id @default(uuid())
  subscriptionId String
  /// Paid-term identity. Period indexes restart at zero for every new term.
  termKey        String       @db.VarChar(128)
  periodIndex    Int
  planId         String       @db.VarChar(32)
  credits        Int
  expiresAt      DateTime
  grantedAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, termKey, periodIndex])
  @@index([expiresAt])
  @@map("subscription_grants")
}

/// One bounded paid-beta wave. The row is the only capacity and lifecycle
/// owner; payment routes consume its View instead of carrying their own flags.
model PaidBetaCampaign {
  id                    String         @id @db.VarChar(64)
  status                String         @db.VarChar(16)
  capacity              Int
  startsAt              DateTime
  endsAt                DateTime?
  legacyPaymentCutoffAt DateTime
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt
  seats                 PaidBetaSeat[]

  @@index([status, startsAt, endsAt])
  @@map("paid_beta_campaigns")
}

/// A person occupying one seat in one paid-beta wave. `campaignId + userId`
/// is the canonical participant identity, so repeat purchases never consume a
/// second seat.
model PaidBetaSeat {
  id         String                   @id @default(uuid())
  campaignId String                   @db.VarChar(64)
  userId     String
  status     String                   @db.VarChar(16)
  paidAt     DateTime?
  releasedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @default(now()) @updatedAt
  campaign   PaidBetaCampaign         @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts   PaidBetaPaymentAttempt[]

  @@unique([campaignId, userId])
  @@index([campaignId, status, createdAt])
  @@index([userId, status])
  @@map("paid_beta_seats")
}

/// A provider-side attempt that belongs to a reserved seat. The provider
/// object identity lets card redirects and webhook replays converge on the
/// same local fact without interpreting URLs or UI state.
model PaidBetaPaymentAttempt {
  id               String       @id @default(uuid())
  seatId           String
  providerKind     String       @db.VarChar(32)
  providerObjectId String?      @unique @db.VarChar(191)
  status           String       @db.VarChar(16)
  expiresAt        DateTime
  paidAt           DateTime?
  terminalAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  seat             PaidBetaSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([seatId, status, expiresAt])
  @@index([status, expiresAt])
  @@map("paid_beta_payment_attempts")
}

/// One explicit request to be contacted when the public beta opens.
/// `campaignId + phoneE164` is the canonical identity, so retries and
/// concurrent submissions cannot create duplicate contact records.
model PublicBetaWaitlistEntry {
  id          String   @id @default(uuid())
  campaignId  String   @db.VarChar(64)
  phoneE164   String   @db.VarChar(32)
  locale      String   @db.VarChar(8)
  source      String   @db.VarChar(32)
  consentedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([campaignId, phoneE164])
  @@index([campaignId, createdAt])
  @@map("public_beta_waitlist_entries")
}

/// A versioned per-user acknowledgement. New announcement versions remain
/// independently deliverable without localStorage or device-specific state.
model AnnouncementReceipt {
  id             String   @id @default(uuid())
  userId         String
  announcementId String   @db.VarChar(96)
  version        Int
  acknowledgedAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId, version])
  @@index([userId, acknowledgedAt])
  @@map("announcement_receipts")
}

model BalanceFreeze {
  id                 String    @id @default(uuid())
  userId             String
  amount             Int
  /// Portion of `amount` taken from the subscription pool. The remainder came
  /// from the permanent pool. Settlement and rollback return each portion to
  /// the pool it came from.
  subscriptionAmount Int       @default(0)
  status             String    @default("pending")
  source             String?   @db.VarChar(64)
  taskId             String?
  requestId          String?
  idempotencyKey     String?   @unique
  metadata           String?   @db.Text
  expiresAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([status])
  @@index([taskId])
  @@map("balance_freezes")
}

model BalanceTransaction {
  id              String   @id @default(uuid())
  userId          String
  type            String
  amount          Int
  balanceAfter    Int
  description     String?  @db.Text
  relatedId       String?
  freezeId        String?
  operatorId      String?  @db.VarChar(64)
  externalOrderId String?  @db.VarChar(128)
  idempotencyKey  String?  @db.VarChar(128)
  projectId       String?  @db.VarChar(128) // 关联项目 ID，用于流水展示项目名
  taskType        String?  @db.VarChar(64) // 任务类型 key（与 action 一致），用于前端 i18n
  billingMeta     String?  @db.Text // 计费详情 JSON: { quantity, unit, model, resolution, duration, tokens... }
  createdAt       DateTime @default(now())

  @@unique([userId, type, idempotencyKey])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([freezeId])
  @@index([externalOrderId])
  @@index([projectId])
  @@map("balance_transactions")
}

model Task {
  id                   String    @id @default(uuid())
  userId               String
  projectId            String
  parentTaskId         String?
  type                 String
  targetType           String
  targetId             String
  status               String    @default("queued")
  progress             Int       @default(0)
  attempt              Int       @default(0)
  dedupeKey            String?   @unique
  operationId          String?   @db.VarChar(128)
  operationSource      String?   @db.VarChar(64)
  operationRequestId   String?   @db.VarChar(128)
  approvalGrantId      String?   @db.VarChar(191)
  operationExecutionId String?   @db.VarChar(191)
  operationPlanTaskId  String?   @db.VarChar(191)
  payload              Json?
  executionFingerprint String?   @db.VarChar(64)
  result               Json?
  failure              Json?
  billingInfo          Json?
  billedAt             DateTime?
  queuedAt             DateTime  @default(now())
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentTask           Task?                     @relation("TaskChildren", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks           Task[]                    @relation("TaskChildren")
  events               TaskEvent[]
  executionCheckpoints TaskExecutionCheckpoint[]
  approvalGrant        ApprovalGrant?            @relation(fields: [approvalGrantId], references: [id], onDelete: Restrict)
  operationExecution   OperationExecution?       @relation(fields: [operationExecutionId], references: [id], onDelete: Restrict)
  workspaceResources   WorkspaceResource[]
  followUpMemberships  FollowUpBatchMember[]

  @@unique([operationExecutionId, operationPlanTaskId])
  @@index([status])
  @@index([type])
  @@index([targetType, targetId])
  @@index([projectId])
  @@index([parentTaskId])
  @@index([projectId, status, updatedAt])
  @@index([projectId, operationId, updatedAt])
  @@index([approvalGrantId])
  @@index([operationExecutionId])
  @@index([userId])
  @@map("tasks")
}

model FollowUpBatch {
  id                     String                @id @db.VarChar(191)
  executionKey           String                @unique @db.VarChar(191)
  threadId               String                @db.VarChar(191)
  originTurnId           String                @db.VarChar(191)
  callId                 String                @db.VarChar(191)
  projectId              String
  userId                 String
  assistantId            String                @db.VarChar(64)
  operationId            String                @db.VarChar(128)
  contextJson            Json
  status                 String                @default("pending") @db.VarChar(32)
  readyByTaskId          String?               @db.VarChar(191)
  readyByTerminalEventId Int?
  notifiedTurnId         String?               @db.VarChar(191)
  readyAt                DateTime?
  notifiedAt             DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  members                FollowUpBatchMember[]

  @@index([threadId, status, createdAt])
  @@index([projectId, userId, status, createdAt])
  @@map("follow_up_batches")
}

model FollowUpBatchMember {
  batchId         String
  taskId          String
  status          String        @default("pending") @db.VarChar(32)
  terminalEventId Int?
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  batch           FollowUpBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  task            Task          @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@id([batchId, taskId])
  @@index([taskId, status, batchId])
  @@map("follow_up_batch_members")
}

model OperationPlanSnapshot {
  id                        String               @id @default(uuid())
  userId                    String
  scopeKind                 String               @db.VarChar(32)
  scopeId                   String               @db.VarChar(191)
  projectId                 String?
  operationId               String               @db.VarChar(128)
  apiRequestId              String?              @db.VarChar(128)
  apiRequestContextHash     String?              @db.VarChar(64)
  executionContractRevision String               @db.VarChar(128)
  normalizedInput           Json
  inputHash                 String               @db.VarChar(64)
  planSnapshot              Json
  planHash                  String               @db.VarChar(64)
  quoteSnapshot             Json
  quoteHash                 String               @db.VarChar(64)
  createdAt                 DateTime             @default(now())
  approvalGrants            ApprovalGrant[]
  executions                OperationExecution[]

  @@unique([userId, scopeKind, scopeId, operationId, apiRequestId], map: "operation_plan_snapshots_api_request_key")
  @@index([userId, scopeKind, scopeId, operationId, createdAt])
  @@map("operation_plan_snapshots")
}

model ApprovalGrant {
  id                  String                @id @default(uuid())
  userId              String
  scopeKind           String                @db.VarChar(32)
  scopeId             String                @db.VarChar(191)
  projectId           String?
  operationId         String                @db.VarChar(128)
  planSnapshotId      String
  requestId           String                @db.VarChar(128)
  inputHash           String                @db.VarChar(64)
  planHash            String                @db.VarChar(64)
  quoteHash           String                @db.VarChar(64)
  quoteCeiling        Int?
  currency            String?               @db.VarChar(16)
  issuedAt            DateTime              @default(now())
  revokedAt           DateTime?
  consumedAt          DateTime?
  consumedExecutionId String?               @db.VarChar(191)
  version             Int                   @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  planSnapshot        OperationPlanSnapshot @relation(fields: [planSnapshotId], references: [id], onDelete: Restrict)
  executions          OperationExecution[]
  tasks               Task[]

  @@unique([planSnapshotId])
  @@index([userId, scopeKind, scopeId, operationId])
  @@index([consumedExecutionId])
  @@map("approval_grants")
}

model OperationExecution {
  id                   String                 @id @default(uuid())
  executionKind        String                 @default("approved_plan") @db.VarChar(32)
  commandId            String?                @unique @db.VarChar(191)
  payloadHash          String?                @db.VarChar(64)
  contractRevision     String?                @db.VarChar(128)
  normalizedInput      Json?
  contextSnapshot      Json?
  source               String?                @db.VarChar(64)
  userId               String
  scopeKind            String                 @db.VarChar(32)
  scopeId              String                 @db.VarChar(191)
  projectId            String?
  operationId          String                 @db.VarChar(128)
  planSnapshotId       String?
  approvalGrantId      String?                @unique
  requestId            String                 @db.VarChar(128)
  status               String                 @db.VarChar(32)
  output               Json?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  planSnapshot         OperationPlanSnapshot? @relation(fields: [planSnapshotId], references: [id], onDelete: Restrict)
  approvalGrant        ApprovalGrant?         @relation(fields: [approvalGrantId], references: [id], onDelete: Restrict)
  tasks                Task[]
  workspaceResources   WorkspaceResource[]    @relation("WorkspaceResourceOperationExecution")
  alternativeResources WorkspaceResource[]    @relation("WorkspaceResourceAlternativeGroupExecution")

  @@unique([planSnapshotId, requestId])
  @@index([userId, scopeKind, scopeId, operationId, createdAt])
  @@index([status, updatedAt])
  @@map("operation_executions")
}

model TaskExecutionCheckpoint {
  id               String    @id @default(uuid())
  taskId           String
  stepKey          String    @db.VarChar(128)
  inputFingerprint String    @db.VarChar(64)
  state            String    @db.VarChar(32)
  output           Json
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepKey])
  @@index([taskId, state])
  @@map("task_execution_checkpoints")
}

model TaskEvent {
  id             Int      @id @default(autoincrement())
  taskId         String
  projectId      String
  userId         String
  eventType      String
  idempotencyKey String?  @unique @db.VarChar(191)
  payload        Json?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, id])
  @@index([taskId])
  @@index([userId])
  @@map("task_events")
}

// ==================== 资产中心 ====================

// 资产文件夹（一层，不支持嵌套）
model GlobalAssetFolder {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  characters GlobalCharacter[]
  locations  GlobalLocation[]

  @@index([userId])
  @@map("global_asset_folders")
}

// 用户级 Asset Hub 角色
model GlobalCharacter {
  id               String   @id @default(uuid())
  userId           String
  folderId         String?
  name             String
  aliases          String?  @db.Text
  profileData      String?  @db.Text
  profileConfirmed Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      GlobalAssetFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  appearances GlobalCharacterAppearance[]

  @@index([userId])
  @@index([folderId])
  @@map("global_characters")
}

// 全局角色形象（结构与 CharacterAppearance 一致）
model GlobalCharacterAppearance {
  id                   String       @id @default(uuid())
  characterId          String
  appearanceIndex      Int
  changeReason         String       @default("default")
  description          String?      @db.Text
  descriptions         String?      @db.Text
  imageUrl             String?      @db.Text
  imageMediaId         String?
  imageMedia           MediaObject? @relation("GlobalCharacterAppearanceImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  imageUrls            String?      @db.Text
  selectedIndex        Int?
  previousImageUrl     String?      @db.Text
  previousImageMediaId String?
  previousImageMedia   MediaObject? @relation("GlobalCharacterAppearancePreviousImageMedia", fields: [previousImageMediaId], references: [id], onDelete: SetNull)
  previousImageUrls    String?      @db.Text
  previousDescription  String?      @db.Text // 上一次的描述词（用于撤回）
  previousDescriptions String?      @db.Text // 上一次的描述词数组（用于撤回）
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  character GlobalCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, appearanceIndex])
  @@index([characterId])
  @@index([imageMediaId])
  @@index([previousImageMediaId])
  @@map("global_character_appearances")
}

// 用户级 Asset Hub 场景
model GlobalLocation {
  id        String   @id @default(uuid())
  userId    String
  folderId  String?
  name      String
  summary   String?  @db.Text
  assetKind String   @default("location")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder GlobalAssetFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  images GlobalLocationImage[]

  @@index([userId])
  @@index([folderId])
  @@map("global_locations")
}

// 全局场景图片（结构与 LocationImage 一致）
model GlobalLocationImage {
  id                   String       @id @default(uuid())
  locationId           String
  imageIndex           Int
  description          String?      @db.Text
  imageUrl             String?      @db.Text
  imageMediaId         String?
  imageMedia           MediaObject? @relation("GlobalLocationImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  isSelected           Boolean      @default(false)
  previousImageUrl     String?      @db.Text
  previousImageMediaId String?
  previousImageMedia   MediaObject? @relation("GlobalLocationImagePreviousImageMedia", fields: [previousImageMediaId], references: [id], onDelete: SetNull)
  previousDescription  String?      @db.Text // 上一次的描述词（用于撤回）
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  location GlobalLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, imageIndex])
  @@index([locationId])
  @@index([imageMediaId])
  @@index([previousImageMediaId])
  @@map("global_location_images")
}

model MediaObject {
  id         String   @id @default(uuid())
  publicId   String   @unique
  storageKey String   @unique @db.VarChar(512)
  sha256     String?
  mimeType   String?
  sizeBytes  BigInt?
  width      Int?
  height     Int?
  durationMs Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  globalCharacterAppearanceImages       GlobalCharacterAppearance[] @relation("GlobalCharacterAppearanceImageMedia")
  globalCharacterAppearancePreviousImgs GlobalCharacterAppearance[] @relation("GlobalCharacterAppearancePreviousImageMedia")
  globalLocationImageImages             GlobalLocationImage[]       @relation("GlobalLocationImageMedia")
  globalLocationImagePreviousImages     GlobalLocationImage[]       @relation("GlobalLocationImagePreviousImageMedia")
  workspaceResourceVersions             WorkspaceResourceVersion[]

  @@index([createdAt])
  @@map("media_objects")
}

model WorkspaceResource {
  id                          String                     @id @db.VarChar(32)
  userId                      String
  projectId                   String
  workspacePath               String                     @db.VarChar(512)
  activePath                  String?                    @db.VarChar(512)
  resourceKind                String                     @default("file") @db.VarChar(16)
  mediaType                   String?                    @db.VarChar(16)
  schemaId                    String                     @db.VarChar(96)
  name                        String                     @db.VarChar(191)
  status                      String                     @default("pending") @db.VarChar(32)
  currentVersion              Int                        @default(0)
  sourceType                  String?                    @db.VarChar(96)
  sourceId                    String?                    @db.VarChar(191)
  memberIndex                 Int?
  prompt                      String?                    @db.LongText
  modelKey                    String?                    @db.VarChar(191)
  generationOptions           Json?
  operationId                 String?                    @db.VarChar(128)
  inputHash                   String?                    @db.VarChar(64)
  taskId                      String?
  operationExecutionId        String?
  alternativeGroupExecutionId String?
  toolCallId                  String?                    @db.VarChar(191)
  materializedAt              DateTime?
  deletedAt                   DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project                     Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task                        Task?                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  operationExecution          OperationExecution?        @relation("WorkspaceResourceOperationExecution", fields: [operationExecutionId], references: [id], onDelete: Restrict)
  alternativeGroupExecution   OperationExecution?        @relation("WorkspaceResourceAlternativeGroupExecution", fields: [alternativeGroupExecutionId], references: [id], onDelete: Restrict)
  versions                    WorkspaceResourceVersion[]
  inputLineage                WorkspaceResourceLineage[] @relation("WorkspaceResourceLineageInput")
  outputLineage               WorkspaceResourceLineage[] @relation("WorkspaceResourceLineageOutput")

  @@unique([projectId, activePath], map: "workspace_resources_project_active_path_key")
  @@unique([sourceType, sourceId], map: "workspace_resources_source_key")
  @@unique([alternativeGroupExecutionId, memberIndex], map: "workspace_resources_alternative_member_key")
  @@index([projectId, deletedAt, workspacePath], map: "workspace_resources_project_tree_idx")
  @@index([userId, projectId, createdAt], map: "workspace_resources_user_project_idx")
  @@index([resourceKind, schemaId, mediaType, createdAt], map: "workspace_resources_kind_schema_media_idx")
  @@index([taskId], map: "workspace_resources_task_idx")
  @@index([operationExecutionId], map: "workspace_resources_execution_idx")
  @@index([alternativeGroupExecutionId], map: "workspace_resources_alternative_group_idx")
  @@index([operationId, inputHash], map: "workspace_resources_operation_input_idx")
  @@map("workspace_resources")
}

model ProjectCanvasLayout {
  id            String                    @id @default(uuid())
  projectId     String
  folderKey     String                    @db.VarChar(191)
  schemaVersion Int                       @default(1)
  viewportX     Float                     @default(0)
  viewportY     Float                     @default(0)
  zoom          Float                     @default(1)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @default(now()) @updatedAt
  project       Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeLayouts   ProjectCanvasNodeLayout[]

  @@unique([projectId, folderKey], map: "project_canvas_layouts_project_folder_key")
  @@index([projectId], map: "project_canvas_layouts_project_idx")
  @@map("project_canvas_layouts")
}

model ProjectCanvasNodeLayout {
  id         String              @id @default(uuid())
  layoutId   String
  nodeKey    String
  nodeType   String
  targetType String
  targetId   String
  x          Float
  y          Float
  width      Float
  height     Float
  zIndex     Int                 @default(0)
  locked     Boolean             @default(false)
  collapsed  Boolean             @default(false)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @default(now()) @updatedAt
  layout     ProjectCanvasLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@unique([layoutId, nodeKey], map: "project_canvas_node_layouts_layout_node_key")
  @@index([layoutId], map: "project_canvas_node_layouts_layout_idx")
  @@index([targetType, targetId], map: "project_canvas_node_layouts_target_idx")
  @@map("project_canvas_node_layouts")
}

model WorkspaceResourceVersion {
  id             String            @id @default(uuid())
  resourceId     String            @db.VarChar(32)
  version        Int
  contentKind    String            @db.VarChar(16)
  mediaId        String
  sha256         String?           @db.VarChar(64)
  sizeBytes      BigInt?
  /// Bounded text/structured preview materialized at write time so tree
  /// listings never read object storage (WR-13). Null for media versions.
  contentPreview String?           @db.VarChar(512)
  sourceTurnId   String?           @db.VarChar(191)
  createdAt      DateTime          @default(now())
  resource       WorkspaceResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  media          MediaObject       @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([resourceId, version], map: "workspace_resource_versions_resource_version_key")
  @@index([mediaId], map: "workspace_resource_versions_media_idx")
  @@map("workspace_resource_versions")
}

model WorkspaceResourceLineage {
  id               String            @id @default(uuid())
  outputResourceId String            @db.VarChar(32)
  outputVersion    Int
  inputResourceId  String            @db.VarChar(32)
  inputVersion     Int
  role             String            @db.VarChar(64)
  position         Int
  createdAt        DateTime          @default(now())
  outputResource   WorkspaceResource @relation("WorkspaceResourceLineageOutput", fields: [outputResourceId], references: [id], onDelete: Cascade)
  inputResource    WorkspaceResource @relation("WorkspaceResourceLineageInput", fields: [inputResourceId], references: [id], onDelete: Restrict)

  @@unique([outputResourceId, outputVersion, role, position], map: "workspace_lineage_output_version_role_position_key")
  @@index([inputResourceId], map: "workspace_lineage_input_idx")
  @@map("workspace_resource_lineage")
}

model LegacyMediaRefBackup {
  id          String   @id @default(uuid())
  runId       String
  tableName   String
  rowId       String
  fieldName   String
  legacyValue String   @db.Text
  checksum    String
  createdAt   DateTime @default(now())

  @@index([runId])
  @@index([tableName, fieldName])
  @@map("legacy_media_refs_backup")
}
